<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- v1.5.33 native meeting room (LiveKit). Runtime-requested, not
         pre-granted. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Qolab Mobile native login screen (v1.4). Shown by MainActivity
             when there is no session cookie; posts to the existing Fortify
             /sanctum/csrf-cookie + /login endpoints and bridges the session
             cookie into the WebView. -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.QolabLogin"
            android:windowSoftInputMode="adjustResize" />

        <!-- Native Home (V1) — post-login landing screen. Loads its data
             from the dev-only /mobile/home aggregate with the existing
             WebView session; WebView shell reached via qolab_start_path. -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Native Office (V1) — opened from the Home bottom nav. Same
             transport and /mobile/home payload as Home. -->
        <activity
            android:name=".OfficeActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Native Engineering Room (department room) — opened from the
             Office department card / Enter. Existing backend contracts only:
             /office/rooms/{slug} page props + /meetings/{id}/detail. -->
        <activity
            android:name=".RoomActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Native Meeting Details — opened from the room Meetings tab.
             GET /meetings/{id}/detail; Summary | Transcript tabs. -->
        <activity
            android:name=".MeetingDetailActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Native The Lobby social room — opened from Office social rooms.
             GET/POST /chat/channels/{id}/messages + /office/rooms/{slug}. -->
        <activity
            android:name=".LobbyActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Native Chat (v1.5.39): conversation list + one conversation.
             Session-authenticated via the WebView transport, realtime via
             Reverb websockets with transport-bridged channel auth. -->
        <activity
            android:name=".ChatListActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ChatScreenActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Native meeting room on LiveKit (v1.5.33). Entered ONLY from
             Meeting Details after POST /meetings/{id}/join-token returned
             server-issued {token,url}. No token/room invention on device. -->
        <activity
            android:name=".LiveRoomActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <!-- LiveKit meetings: requested at first use (runtime), not at install. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
