<?xml version="1.0" encoding="utf-8"?>
<!-- ═══ Qolab Mobile — Chat v1.5.40 (approved mockup) ═══
     Qolab wordmark + Chat heading + subtitle → search action pill →
     filter chips (All | DMs | Groups | Announcements) → yellow
     Announcements banner → Pinned / Recent conversation sections →
     floating compose FAB. Real backend data only. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/qm_canvas">

    <!-- Header: wordmark + heading + subtitle -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/qm_room_page_pad"
        android:paddingEnd="@dimen/qm_room_page_pad"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_wordmark"
                    android:textColor="@color/qm_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/qm_bg_pin_circle"
                    android:backgroundTint="@color/qm_red_dot"
                    android:contentDescription="@string/chat_wordmark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/chat_title"
                    android:textColor="@color/qm_ink"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <ImageButton
                    android:id="@+id/chat_btn_back"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/qm_ic_back"
                    android:scaleType="center"
                    android:background="@null"
                    android:visibility="gone"
                    android:importantForAccessibility="no"
                    android:contentDescription="@string/room_cd_back"
                    tools:ignore="Suspicious0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/chat_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/chat_subtitle"
                android:textColor="@color/qm_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Search action (opens the search field) -->
        <ImageButton
            android:id="@+id/chat_btn_search"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/qm_ic_search"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_cd_search" />

        <!-- New group (kept from v1.5.39; secondary to the FAB) -->
        <ImageButton
            android:id="@+id/chat_btn_new_group"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/qm_ic_new_group"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_new_group" />
    </LinearLayout>

    <!-- Search field (hidden until the search action is tapped) -->
    <EditText
        android:id="@+id/chat_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/qm_room_page_pad"
        android:layout_marginEnd="@dimen/qm_room_page_pad"
        android:layout_marginBottom="6dp"
        android:background="@drawable/qm_bg_room_tabs"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="@string/chat_search_hint"
        android:textColorHint="@color/qm_muted"
        android:textColor="@color/qm_ink"
        android:textSize="14sp"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:visibility="gone" />

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingStart="@dimen/qm_room_page_pad"
        android:paddingEnd="@dimen/qm_room_page_pad">

        <LinearLayout
            android:id="@+id/chat_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/chat_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/qm_bg_filter_active"
                android:text="@string/chat_filter_all"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_filter_dms"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/qm_bg_filter_idle"
                android:text="@string/chat_filter_dms"
                android:textColor="@color/qm_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chat_filter_groups"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/qm_bg_filter_idle"
                android:text="@string/chat_filter_groups"
                android:textColor="@color/qm_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chat_filter_announcements"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/qm_bg_filter_idle"
                android:text="@string/chat_filter_announcements"
                android:textColor="@color/qm_ink"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Announcements banner (yellow, mockup) — inflated only when a real
         published announcement exists; opens the announcements page. -->
    <LinearLayout
        android:id="@+id/chat_announcement_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/qm_room_page_pad"
        android:layout_marginEnd="@dimen/qm_room_page_pad"
        android:layout_marginBottom="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/qm_bg_announcement_banner"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/qm_ic_pin"
            android:background="@drawable/qm_bg_pin_circle"
            android:padding="2dp"
            android:contentDescription="@string/chat_announcements_banner" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_banner_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/qm_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_banner_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/qm_ink"
                android:textSize="11sp"
                android:alpha="0.75" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/chat_announcements_open"
            android:textColor="@color/qm_ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Conversation sections -->
        <ScrollView
            android:id="@+id/chat_list_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/qm_room_page_pad"
                android:paddingEnd="@dimen/qm_room_page_pad"
                android:paddingBottom="96dp" />
        </ScrollView>

        <!-- Skeleton -->
        <LinearLayout
            android:id="@+id/chat_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/qm_room_page_pad"
            android:paddingEnd="@dimen/qm_room_page_pad"
            android:paddingTop="6dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/qm_bg_skeleton" />
        </LinearLayout>

        <!-- Error + retry -->
        <LinearLayout
            android:id="@+id/chat_error_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/room_error"
                android:textColor="@color/qm_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:text="@string/room_retry"
                android:textColor="@color/qm_wine"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty -->
        <TextView
            android:id="@+id/chat_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:gravity="center"
            android:text="@string/chat_empty"
            android:textColor="@color/qm_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Floating compose action -->
        <FrameLayout
            android:id="@+id/chat_fab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/qm_bg_chat_fab"
            android:elevation="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/qm_ic_compose"
                android:contentDescription="@string/chat_cd_compose" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
