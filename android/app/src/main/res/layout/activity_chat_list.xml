<?xml version="1.0" encoding="utf-8"?>
<!-- ═══ Qolab Mobile — Chat: conversation list ═══
     Header (title) → search field → list of conversations.
     FAB-style header action opens the Create Group flow. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/qm_canvas">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/qm_room_page_pad"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/chat_btn_back"
            android:layout_width="@dimen/qm_room_back_target"
            android:layout_height="@dimen/qm_room_back_target"
            android:layout_marginStart="-12dp"
            android:src="@drawable/qm_ic_back"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/room_cd_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/chat_title"
            android:textColor="@color/qm_ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />

        <ImageButton
            android:id="@+id/chat_btn_new_group"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/qm_ic_new_group"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_new_group" />
    </LinearLayout>

    <!-- Search -->
    <EditText
        android:id="@+id/chat_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/qm_room_page_pad"
        android:layout_marginEnd="@dimen/qm_room_page_pad"
        android:layout_marginBottom="8dp"
        android:background="@drawable/qm_bg_room_tabs"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="@string/chat_search_hint"
        android:textColorHint="@color/qm_muted"
        android:textColor="@color/qm_ink"
        android:textSize="14sp"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:inputType="text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Conversation list -->
        <ScrollView
            android:id="@+id/chat_list_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </ScrollView>

        <!-- Loading skeleton -->
        <LinearLayout
            android:id="@+id/chat_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/qm_room_page_pad"
            android:paddingEnd="@dimen/qm_room_page_pad"
            android:paddingTop="6dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/qm_bg_skeleton" />
        </LinearLayout>

        <!-- Error + retry -->
        <LinearLayout
            android:id="@+id/chat_error_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/chat_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/room_error"
                android:textColor="@color/qm_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:text="@string/room_retry"
                android:textColor="@color/qm_wine"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty state -->
        <TextView
            android:id="@+id/chat_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/chat_empty"
            android:textColor="@color/qm_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
