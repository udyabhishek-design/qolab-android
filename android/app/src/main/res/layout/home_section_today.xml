<?xml version="1.0" encoding="utf-8"?>
<!-- Home — Today: quiet compact summary strip (Tasks / Meetings / Updates) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/qm_home_section_gap"
    android:orientation="horizontal"
    android:background="@drawable/qm_bg_today_strip"
    android:padding="@dimen/qm_home_today_strip_pad">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/home_today_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/qm_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/home_today_tasks"
            android:textColor="@color/qm_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/home_today_meetings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/qm_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/home_today_meetings"
            android:textColor="@color/qm_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/home_today_updates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/qm_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/home_today_updates"
            android:textColor="@color/qm_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
