<?xml version="1.0" encoding="utf-8"?>
<!-- Home V1 — Continue Working: mint conversation + lavender task -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_home_section_gap"
        android:text="@string/home_section_continue"
        android:textColor="@color/qm_ink"
        android:textSize="@dimen/qm_home_section_title"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- mint: recent conversation -->
        <LinearLayout
            android:id="@+id/home_continue_conversation"
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_continue_height"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/qm_bg_card_mint"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_continue_conversation_label"
                android:textColor="@color/qm_mint_text"
                android:alpha="0.7"
                android:textSize="11sp"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/home_continue_conversation_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/qm_mint_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/home_continue_conversation_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/qm_mint_text"
                android:alpha="0.8"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:id="@+id/home_continue_conversation_skeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_continue_height"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/qm_bg_skeleton" />

        <!-- lavender: due task -->
        <LinearLayout
            android:id="@+id/home_continue_task"
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_continue_height"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:background="@drawable/qm_bg_card_lavender"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_continue_task_label"
                android:textColor="@color/qm_lavender_text"
                android:alpha="0.7"
                android:textSize="11sp"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/home_continue_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/qm_lavender_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/home_continue_task_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/qm_lavender_text"
                android:alpha="0.8"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:id="@+id/home_continue_task_skeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_continue_height"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/qm_bg_skeleton" />
    </LinearLayout>

    <TextView
        android:id="@+id/home_continue_both_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/home_continue_conversation_empty"
        android:textColor="@color/qm_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
