<?xml version="1.0" encoding="utf-8"?>
<!-- Office — fixed bottom navigation: Home / Office / [Ask Drytis focal] / Chat
     Warm-white container; Office active = wine icon + wine bold label; Home
     inactive = muted gray. Ask Drytis: 44dp wine circle, label fully below
     the circle. System bottom inset applied at runtime via applyInsets(). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@color/qm_nav_bg">

    <LinearLayout
        android:id="@+id/office_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/office_nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/office_nav_home_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/qm_ic_home"
                android:tint="@color/qm_nav_unselected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/office_nav_home"
                android:textColor="@color/qm_nav_unselected"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/office_nav_office"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/office_nav_office_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/qm_ic_office"
                android:tint="@color/qm_wine" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/office_nav_office"
                android:textColor="@color/qm_wine"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Ask Drytis — circular wine focal button, label below the circle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/office_nav_ask_drytis"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/qm_bg_ask_drytis">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/qm_ic_sparkle"
                    android:contentDescription="@string/office_nav_cd_ask_drytis" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/office_nav_ask_drytis"
                android:textColor="@color/qm_nav_unselected"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/office_nav_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/office_nav_chat_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/qm_ic_chat"
                android:tint="@color/qm_nav_unselected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/office_nav_chat"
                android:textColor="@color/qm_nav_unselected"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
