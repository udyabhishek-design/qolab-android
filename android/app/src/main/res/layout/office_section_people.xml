<?xml version="1.0" encoding="utf-8"?>
<!-- Office — People Around. Real presence counts are NOT available to the
     app (presence is Redis-resolved server-side and only rendered inside
     the web Directory Inertia page). Honest treatment: three status cards
     with a clean unavailable note — no invented counts. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_home_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/office_people_around"
            android:textColor="@color/qm_ink"
            android:textSize="@dimen/qm_home_section_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/office_people_see_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/office_see_all"
            android:textColor="@color/qm_wine"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Online — soft green -->
        <LinearLayout
            android:id="@+id/office_people_online"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:background="@drawable/qm_bg_tile_mint"
            android:padding="12dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/qm_dot_online" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/office_people_online"
                android:textColor="@color/qm_mint_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/office_people_online_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/office_count_unavailable"
                android:textColor="@color/qm_mint_text"
                android:alpha="0.75"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- In a meeting — soft lavender -->
        <LinearLayout
            android:id="@+id/office_people_meeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:background="@drawable/qm_bg_tile_lavender"
            android:padding="12dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/qm_dot_lavender" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/office_people_meeting"
                android:textColor="@color/qm_lavender_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/office_people_meeting_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/office_count_unavailable"
                android:textColor="@color/qm_lavender_text"
                android:alpha="0.75"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Offline — soft red/peach -->
        <LinearLayout
            android:id="@+id/office_people_offline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:orientation="vertical"
            android:background="@drawable/qm_bg_tile_peach"
            android:padding="12dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/qm_dot_peach" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/office_people_offline"
                android:textColor="@color/qm_peach_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/office_people_offline_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/office_count_unavailable"
                android:textColor="@color/qm_peach_text"
                android:alpha="0.75"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/office_people_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/office_people_note"
        android:textColor="@color/qm_muted"
        android:textSize="10sp" />
</LinearLayout>
