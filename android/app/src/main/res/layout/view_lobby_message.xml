<?xml version="1.0" encoding="utf-8"?>
<!-- Lobby → one discussion message (card, wine speaker, human timestamp,
     optional thread indicator; NOT a chat bubble) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/qm_bg_room_card"
    android:padding="@dimen/qm_room_card_pad"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lobby_msg_sender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/qm_wine"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/lobby_msg_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/qm_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lobby_msg_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/qm_ink"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:id="@+id/lobby_msg_thread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/qm_bg_room_tabs"
        android:textColor="@color/qm_wine"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
