<?xml version="1.0" encoding="utf-8"?>
<!-- Home V1 — Next Meeting: large yellow card, skeleton, empty (same footprint), error -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_home_section_gap"
        android:text="@string/home_section_next_meeting"
        android:textColor="@color/qm_ink"
        android:textSize="@dimen/qm_home_section_title"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/home_meeting_card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qm_home_meeting_height"
            android:orientation="vertical"
            android:background="@drawable/qm_bg_card_yellow"
            android:padding="@dimen/qm_home_card_pad"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/home_meeting_calendar_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/qm_ic_calendar"
                    android:importantForAccessibility="no"
                    app:tint="@color/qm_yellow_text"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/home_meeting_label"
                    android:textColor="@color/qm_yellow_text"
                    android:alpha="0.75"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_meeting_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/qm_yellow_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_meeting_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/qm_yellow_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/home_meeting_avatars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/home_meeting_overflow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/qm_yellow_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/home_meeting_skeleton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qm_home_meeting_height"
            android:background="@drawable/qm_bg_skeleton" />

        <LinearLayout
            android:id="@+id/home_meeting_empty"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qm_home_meeting_height"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/qm_bg_card_yellow"
            android:padding="@dimen/qm_home_card_pad"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_meeting_empty_title"
                android:textColor="@color/qm_yellow_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/home_meeting_empty_support"
                android:textColor="@color/qm_yellow_text"
                android:alpha="0.75"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_meeting_error"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qm_home_meeting_height"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/qm_bg_card_white"
            android:padding="@dimen/qm_home_card_pad"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_error_section"
                android:textColor="@color/qm_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/home_meeting_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/home_retry"
                android:textColor="@color/qm_wine"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
