<?xml version="1.0" encoding="utf-8"?>
<!-- Home — Next Meeting: compact horizontal yellow card. Data state and the
     elegant empty state live in the SAME card footprint. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_home_section_gap"
        android:text="@string/home_section_next_meeting"
        android:textColor="@color/qm_ink"
        android:textSize="@dimen/qm_home_section_title"
        android:textStyle="bold" />

    <!-- DATA state -->
    <LinearLayout
        android:id="@+id/home_meeting_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qm_home_meeting_height"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/qm_bg_card_yellow"
        android:padding="@dimen/qm_home_card_pad"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/qm_home_meeting_icon"
            android:layout_height="@dimen/qm_home_meeting_icon"
            android:background="@drawable/qm_bg_meeting_icon_block">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/qm_ic_calendar"
                android:importantForAccessibility="no"
                app:tint="@color/qm_ink" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_meeting_label"
                android:textColor="@color/qm_yellow_text"
                android:alpha="0.7"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_meeting_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/qm_yellow_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_meeting_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/qm_yellow_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/home_meeting_avatars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/home_meeting_overflow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/qm_yellow_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- EMPTY state — same compact yellow card, elegant one-liner -->
    <LinearLayout
        android:id="@+id/home_meeting_empty"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qm_home_meeting_height"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/qm_bg_card_yellow"
        android:padding="@dimen/qm_home_card_pad"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/qm_home_meeting_icon"
            android:layout_height="@dimen/qm_home_meeting_icon"
            android:background="@drawable/qm_bg_meeting_icon_block">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/qm_ic_calendar"
                android:importantForAccessibility="no"
                app:tint="@color/qm_ink" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_meeting_empty_title"
                android:textColor="@color/qm_yellow_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/home_meeting_empty_support"
                android:textColor="@color/qm_yellow_text"
                android:alpha="0.75"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- LOADING skeleton -->
    <View
        android:id="@+id/home_meeting_skeleton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qm_home_meeting_height"
        android:layout_marginTop="8dp"
        android:background="@drawable/qm_bg_skeleton" />

    <!-- ERROR -->
    <LinearLayout
        android:id="@+id/home_meeting_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/qm_error_surface"
        android:padding="@dimen/qm_home_card_pad"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_error_section"
            android:textColor="@color/qm_error"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/home_meeting_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/home_retry"
            android:textColor="@color/qm_wine"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
