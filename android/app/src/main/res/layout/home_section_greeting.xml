<?xml version="1.0" encoding="utf-8"?>
<!-- Home V1 — greeting: date, time-of-day greeting + first name, support line -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/home_greeting_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/qm_muted"
        android:textSize="@dimen/qm_home_greeting_date" />

    <TextView
        android:id="@+id/home_greeting_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/qm_ink"
        android:textSize="@dimen/qm_home_greeting_name"
        android:textStyle="bold"
        android:letterSpacing="-0.01" />

    <TextView
        android:id="@+id/home_greeting_support"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/home_greeting_support_line"
        android:textColor="@color/qm_muted"
        android:textSize="@dimen/qm_home_greeting_support" />

    <!-- v1.5.44: non-blocking refresh-failure warning. Only made visible
         by HomeActivity when a background refresh fails while valid
         content stays on screen. Tapping it retries. -->
    <LinearLayout
        android:id="@+id/home_refresh_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/qm_bg_card_white"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_refresh_warning"
            android:textColor="@color/qm_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/home_retry"
            android:textStyle="bold"
            android:textColor="@color/qm_ink"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
