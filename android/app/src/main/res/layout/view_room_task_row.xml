<?xml version="1.0" encoding="utf-8"?>
<!-- Room → Tasks tab → task row -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/qm_bg_room_card"
    android:padding="@dimen/qm_room_card_pad"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/room_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/qm_ink"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/room_task_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/room_task_assignee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/qm_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/room_task_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/qm_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/room_task_priority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/room_task_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/qm_muted"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
