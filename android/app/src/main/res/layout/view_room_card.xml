<?xml version="1.0" encoding="utf-8"?>
<!-- Home — one social room card in the responsive 3-column grid.
     Width comes from the grid layout weight (computed from available screen
     width); height from qm_home_room_card_height. Colors (bg, title, text,
     arrow circle) are applied in code from the room theme. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qm_home_room_card_height"
    android:orientation="vertical"
    android:padding="@dimen/qm_home_room_card_pad">

    <TextView
        android:id="@+id/room_card_online"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/qm_home_room_text_online"
        android:textStyle="bold"
        android:alpha="0.9" />

    <TextView
        android:id="@+id/room_card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/qm_home_room_text_name"
        android:textStyle="bold"
        android:lineSpacingExtra="-2dp" />

    <TextView
        android:id="@+id/room_card_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/qm_home_room_text_desc"
        android:alpha="0.85" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/room_card_avatars"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/room_card_overflow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textSize="@dimen/qm_home_room_text_online"
            android:alpha="0.9" />

        <FrameLayout
            android:id="@+id/room_card_arrow_circle"
            android:layout_width="@dimen/qm_home_room_arrow_circle"
            android:layout_height="@dimen/qm_home_room_arrow_circle"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/room_card_arrow"
                android:layout_width="@dimen/qm_home_room_arrow_icon"
                android:layout_height="@dimen/qm_home_room_arrow_icon"
                android:layout_gravity="center"
                android:src="@drawable/qm_ic_arrow_right"
                android:importantForAccessibility="no"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:tint="#FFFFFFFF" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
