<?xml version="1.0" encoding="utf-8"?>
<!-- Office — Social Rooms: responsive 3-column grid (reuses Home's room
     card layout view_room_card). No horizontal scrolling, no clipping. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_home_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/office_social_rooms"
            android:textColor="@color/qm_ink"
            android:textSize="@dimen/qm_home_section_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/office_rooms_see_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/office_see_all"
            android:textColor="@color/qm_wine"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/office_rooms_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/office_rooms_skeleton_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_room_card_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/qm_home_room_gap"
            android:background="@drawable/qm_bg_skeleton" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_room_card_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/qm_home_room_gap"
            android:background="@drawable/qm_bg_skeleton" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_room_card_height"
            android:layout_weight="1"
            android:background="@drawable/qm_bg_skeleton" />
    </LinearLayout>

    <TextView
        android:id="@+id/office_rooms_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_rooms_empty"
        android:textColor="@color/qm_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/office_rooms_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="6dp"
        android:text="@string/home_retry"
        android:textColor="@color/qm_wine"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
