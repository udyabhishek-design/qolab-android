<?xml version="1.0" encoding="utf-8"?>
<!-- Engineering Room → Create Meeting bottom sheet (v1.5.31).
     Fields exactly as the existing POST /office/rooms/{room}/meetings
     contract supports: title, description, scheduled_at (date+time),
     timezone (auto, read-only), participants (real room members).
     No duration field — the contract has none. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/qm_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/qm_room_page_pad">

        <TextView
            android:id="@+id/cm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cm_heading"
            android:textColor="@color/qm_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cm_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/qm_muted"
            android:textSize="12sp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qm_room_section_gap"
            android:text="@string/cm_field_title"
            android:textColor="@color/qm_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/cm_input_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="46dp"
            android:background="@drawable/qm_bg_room_card"
            android:padding="12dp"
            android:hint="@string/cm_hint_title"
            android:textColorHint="@color/qm_muted"
            android:textColor="@color/qm_ink"
            android:textSize="14sp"
            android:inputType="textCapSentences"
            android:maxLines="2" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cm_field_description"
            android:textColor="@color/qm_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/cm_input_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="46dp"
            android:background="@drawable/qm_bg_room_card"
            android:padding="12dp"
            android:hint="@string/cm_hint_description"
            android:textColorHint="@color/qm_muted"
            android:textColor="@color/qm_ink"
            android:textSize="14sp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />

        <!-- Date + time (scheduled_at) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cm_field_date"
                    android:textColor="@color/qm_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cm_pick_date"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/qm_bg_room_card"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/cm_pick_date_empty"
                    android:textColor="@color/qm_ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cm_field_time"
                    android:textColor="@color/qm_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cm_pick_time"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/qm_bg_room_card"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/cm_pick_time_empty"
                    android:textColor="@color/qm_ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Timezone (auto from device; read-only, shown for clarity) -->
        <TextView
            android:id="@+id/cm_timezone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/qm_muted"
            android:textSize="12sp" />

        <!-- Participants -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cm_field_participants"
            android:textColor="@color/qm_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cm_participants_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- Error line -->
        <TextView
            android:id="@+id/cm_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/qm_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <TextView
                android:id="@+id/cm_start_now"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/cm_action_start_now"
                android:textColor="@color/qm_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cm_cancel"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/cm_action_cancel"
                android:textColor="@color/qm_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/cm_create"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/qm_bg_room_tab_active"
                android:text="@string/cm_action_schedule"
                android:textColor="@color/qm_cream_on_wine"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/cm_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
