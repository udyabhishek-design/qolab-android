<?xml version="1.0" encoding="utf-8"?>
<!-- Home V1 — Social Rooms: horizontal scrolling color cards -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_home_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_section_social_rooms"
            android:textColor="@color/qm_ink"
            android:textSize="@dimen/qm_home_section_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_rooms_see_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_rooms_see_all"
            android:textColor="@color/qm_wine"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/home_rooms_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/home_rooms_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/qm_home_room_card_width"
                android:layout_height="@dimen/qm_home_room_card_height"
                android:layout_marginEnd="12dp"
                android:background="@drawable/qm_bg_skeleton" />

            <View
                android:layout_width="@dimen/qm_home_room_card_width"
                android:layout_height="@dimen/qm_home_room_card_height"
                android:background="@drawable/qm_bg_skeleton" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/home_rooms_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/home_rooms_empty"
        android:textColor="@color/qm_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
