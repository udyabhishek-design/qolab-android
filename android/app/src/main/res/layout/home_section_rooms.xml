<?xml version="1.0" encoding="utf-8"?>
<!-- Home — Social Rooms: responsive 3-column grid, all cards fully visible -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_home_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_section_social_rooms"
            android:textColor="@color/qm_ink"
            android:textSize="@dimen/qm_home_section_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_rooms_see_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_rooms_see_all"
            android:textColor="@color/qm_wine"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Responsive 3-column grid: no horizontal scrolling, no clipping.
         Card width is computed at runtime from the row's measured width
         (see HomeActivity.applyRoomsGrid()); here we only set the gap. -->
    <LinearLayout
        android:id="@+id/home_rooms_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/home_rooms_skeleton_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_room_card_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/qm_home_room_gap"
            android:background="@drawable/qm_bg_skeleton" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_room_card_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/qm_home_room_gap"
            android:background="@drawable/qm_bg_skeleton" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/qm_home_room_card_height"
            android:layout_weight="1"
            android:background="@drawable/qm_bg_skeleton" />
    </LinearLayout>

    <TextView
        android:id="@+id/home_rooms_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/home_rooms_empty"
        android:textColor="@color/qm_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
