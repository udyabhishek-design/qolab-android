<?xml version="1.0" encoding="utf-8"?>
<!-- Meeting Details → Summary tab -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meeting_summary_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/qm_meeting_page_pad"
    android:paddingEnd="@dimen/qm_meeting_page_pad"
    android:paddingTop="@dimen/qm_meeting_section_gap"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <View
        android:id="@+id/meeting_summary_skeleton"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/qm_bg_skeleton" />

    <!-- Facts card -->
    <LinearLayout
        android:id="@+id/meeting_summary_facts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/qm_bg_room_card"
        android:padding="@dimen/qm_meeting_card_pad"
        android:visibility="gone">

        <TextView
            android:id="@+id/meeting_summary_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/qm_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meeting_summary_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/qm_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/meeting_summary_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/qm_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- AI summary -->
    <TextView
        android:id="@+id/meeting_summary_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_meeting_section_gap"
        android:text="@string/meeting_detail_summary"
        android:textColor="@color/qm_ink"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/meeting_summary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/qm_bg_room_card"
        android:padding="@dimen/qm_meeting_card_pad"
        android:textColor="@color/qm_ink"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/meeting_summary_none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/qm_bg_room_card"
        android:padding="@dimen/qm_meeting_card_pad"
        android:text="@string/meeting_detail_no_summary"
        android:textColor="@color/qm_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Key decisions -->
    <TextView
        android:id="@+id/meeting_decisions_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_meeting_section_gap"
        android:text="@string/meeting_detail_key_decisions"
        android:textColor="@color/qm_ink"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/meeting_decisions_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Follow-ups -->
    <TextView
        android:id="@+id/meeting_followups_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_meeting_section_gap"
        android:text="@string/meeting_detail_follow_ups"
        android:textColor="@color/qm_ink"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/meeting_followups_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Action items -->
    <TextView
        android:id="@+id/meeting_actions_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_meeting_section_gap"
        android:text="@string/meeting_detail_action_items"
        android:textColor="@color/qm_ink"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/meeting_actions_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/qm_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/meeting_actions_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/meeting_actions_none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/qm_bg_room_card"
        android:padding="@dimen/qm_meeting_card_pad"
        android:text="@string/meeting_detail_no_action_items"
        android:textColor="@color/qm_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
