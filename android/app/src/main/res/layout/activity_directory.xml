<?xml version="1.0" encoding="utf-8"?>
<!-- ═══ Qolab Mobile — Directory (v1.5.53) ═══
     Qolab design system: warm light canvas, wordmark header, search
     field, member rows (initials avatar / name / department·designation).
     Skeleton / error+Retry / empty / no-search-results states.
     Real members only — GET /directory via the authenticated WebView
     transport. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/qm_canvas">

    <!-- Header: wordmark + heading (Chat list / Meetings list pattern) -->
    <LinearLayout
        android:id="@+id/directory_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/qm_room_page_pad"
        android:paddingEnd="@dimen/qm_room_page_pad"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/directory_wordmark"
                    android:textColor="@color/qm_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/qm_bg_pin_circle"
                    android:backgroundTint="@color/qm_red_dot"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/directory_title"
                android:textColor="@color/qm_ink"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/directory_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/directory_subtitle"
                android:textColor="@color/qm_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/directory_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/qm_ic_back"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/room_cd_back" />
    </LinearLayout>

    <!-- Search field (always visible — Directory's primary interaction) -->
    <EditText
        android:id="@+id/directory_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/qm_room_page_pad"
        android:layout_marginEnd="@dimen/qm_room_page_pad"
        android:layout_marginBottom="6dp"
        android:background="@drawable/qm_bg_room_tabs"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="@string/directory_search_hint"
        android:textColorHint="@color/qm_muted"
        android:textColor="@color/qm_ink"
        android:textSize="14sp"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:inputType="text" />

    <!-- Load more (pagination footer pill, hidden until needed) -->
    <TextView
        android:id="@+id/directory_load_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/qm_bg_room_tab_active"
        android:text="@string/directory_load_more"
        android:textColor="@color/qm_cream_on_wine"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/directory_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/directory_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/qm_room_page_pad"
                android:paddingEnd="@dimen/qm_room_page_pad"
                android:paddingTop="6dp"
                android:paddingBottom="24dp" />
        </ScrollView>

        <!-- Skeleton -->
        <LinearLayout
            android:id="@+id/directory_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/qm_room_page_pad"
            android:paddingEnd="@dimen/qm_room_page_pad"
            android:paddingTop="6dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/qm_bg_skeleton" />
        </LinearLayout>

        <!-- Error + Retry -->
        <LinearLayout
            android:id="@+id/directory_error_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/room_error"
                android:textColor="@color/qm_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/directory_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:text="@string/room_retry"
                android:textColor="@color/qm_wine"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty -->
        <TextView
            android:id="@+id/directory_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:gravity="center"
            android:text="@string/directory_empty"
            android:textColor="@color/qm_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- No search results (distinct from empty directory) -->
        <TextView
            android:id="@+id/directory_no_results"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:gravity="center"
            android:text="@string/directory_no_results"
            android:textColor="@color/qm_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
