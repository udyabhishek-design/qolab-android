<?xml version="1.0" encoding="utf-8"?>
<!-- Room → Meetings tab -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/room_tab_meetings_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/qm_room_page_pad"
    android:paddingEnd="@dimen/qm_room_page_pad"
    android:paddingTop="@dimen/qm_room_section_gap"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <!-- Loading skeleton -->
    <View
        android:id="@+id/room_meetings_skeleton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qm_room_meeting_card_height"
        android:layout_marginBottom="12dp"
        android:background="@drawable/qm_bg_skeleton" />

    <TextView
        android:id="@+id/room_meetings_live_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/room_meeting_live"
        android:textColor="@color/qm_ink"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/room_meetings_live_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/room_meetings_upcoming_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_room_section_gap"
        android:text="@string/room_upcoming_meeting"
        android:textColor="@color/qm_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/room_meetings_upcoming_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/room_meetings_upcoming_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/qm_bg_room_card"
        android:padding="@dimen/qm_room_card_pad"
        android:text="@string/room_no_meetings"
        android:textColor="@color/qm_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/room_meetings_previous_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_room_section_gap"
        android:text="@string/room_recent_meetings"
        android:textColor="@color/qm_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/room_meetings_completed_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/room_meetings_completed_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/qm_bg_room_card"
        android:padding="@dimen/qm_room_card_pad"
        android:text="@string/room_no_completed"
        android:textColor="@color/qm_muted"
        android:textSize="13sp" />
</LinearLayout>
