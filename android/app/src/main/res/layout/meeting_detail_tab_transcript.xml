<?xml version="1.0" encoding="utf-8"?>
<!-- Meeting Details → Transcript tab -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meeting_transcript_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/qm_meeting_page_pad"
    android:paddingEnd="@dimen/qm_meeting_page_pad"
    android:paddingTop="@dimen/qm_meeting_section_gap"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <View
        android:id="@+id/meeting_transcript_skeleton"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/qm_bg_skeleton" />

    <TextView
        android:id="@+id/meeting_transcript_none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/qm_bg_room_card"
        android:padding="@dimen/qm_meeting_card_pad"
        android:text="@string/meeting_detail_transcript_none"
        android:textColor="@color/qm_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Current session transcript (or the only session) -->
    <LinearLayout
        android:id="@+id/meeting_transcript_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Historical sessions -->
    <TextView
        android:id="@+id/meeting_transcript_sessions_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_meeting_section_gap"
        android:text="@string/meeting_detail_sessions_title"
        android:textColor="@color/qm_ink"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/meeting_transcript_sessions_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
