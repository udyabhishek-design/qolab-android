<?xml version="1.0" encoding="utf-8"?>
<!--
  Qolab Mobile — Login (v1.4.2 compact, fully-composed single viewport)

  One fixed vertical composition, no weighted spacers, no clipped/peeking
  decoration. Root uses fitsSystemWindows so status + gesture insets are
  consumed as padding — the bottom cards end ABOVE the navigation area.

  Fixed height budget @360w (compact tier):
    brand 25 + 10 + headline 71 + 8 + [subcopy|yellow] 108 + 14
    + form 261 + 14 + bottom cards ~100 + 12 pad
    ≈ 623dp of content + system insets (~96dp worst case) < 780dp viewport
  → nothing scrolls on a Motorola G32-class screen with the keyboard closed.
  The ScrollView is an emergency fallback only (keyboard / font scaling).

  Taller devices (values-h860dp) get slightly larger headline + card type;
  gaps stay fixed so no blank band can appear.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qm_canvas"
    android:fitsSystemWindows="true"
    tools:context=".LoginActivity">

    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:descendantFocusability="beforeDescendants"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <!-- ═══ Brand — wordmark + red dot ═══ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_wordmark"
                    android:textColor="@color/qm_ink"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:fontFamily="sans-serif-black"
                    android:contentDescription="@string/login_wordmark" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/qm_red_dot"
                    android:contentDescription="@string/login_wordmark" />
            </LinearLayout>

            <!-- ═══ Headline ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/login_headline_line1"
                android:textColor="@color/qm_ink"
                android:textSize="@dimen/qm_login_headline"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/login_headline_line2"
                android:textColor="@color/qm_wine"
                android:textSize="@dimen/qm_login_headline"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.04" />

            <!-- ═══ Supporting copy + compact yellow card (one row) ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/login_subcopy"
                    android:textColor="@color/qm_muted"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.25"
                    android:maxLines="3" />

                <!-- Design accent — NOT interactive. Fixed height: decoration
                     must never push the form below the fold. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/qm_login_yellow_height"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/qm_block_yellow"
                    android:paddingStart="14dp"
                    android:end="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:importantForAccessibility="no">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_yellow_line1"
                        android:textColor="@color/qm_ink"
                        android:textSize="@dimen/qm_login_yellow_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_yellow_line2"
                        android:textColor="@color/qm_ink"
                        android:textSize="@dimen/qm_login_yellow_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_yellow_line3"
                        android:textColor="@color/qm_ink"
                        android:textSize="@dimen/qm_login_yellow_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_yellow_line4"
                        android:textColor="@color/qm_ink"
                        android:textSize="@dimen/qm_login_yellow_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.1" />

                    <!-- Minimal accent line -->
                    <View
                        android:layout_width="24dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="7dp"
                        android:background="@color/qm_ink" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Login form ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <!-- Work email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_label_email"
                    android:textColor="@color/qm_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">

                    <EditText
                        android:id="@+id/login_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/qm_login_field_height"
                        android:background="@drawable/qm_field"
                        android:hint="@string/login_hint_email"
                        android:textColorHint="@color/qm_icon_gray"
                        android:textColor="@color/qm_ink"
                        android:textSize="16sp"
                        android:inputType="textEmailAddress"
                        android:autofillHints="email"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:paddingStart="48dp"
                        android:paddingEnd="14dp"
                        android:contentDescription="@string/login_label_email" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/qm_ic_mail"
                        android:contentDescription="@string/login_icon_mail"
                        android:tint="@color/qm_icon_gray"
                        tools:ignore="UseAppTint" />
                </FrameLayout>

                <TextView
                    android:id="@+id/login_email_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/qm_error"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Enter a valid email address"
                    tools:visibility="visible" />

                <!-- Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/login_label_password"
                    android:textColor="@color/qm_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">

                    <EditText
                        android:id="@+id/login_password"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/qm_login_field_height"
                        android:background="@drawable/qm_field"
                        android:hint="@string/login_hint_password"
                        android:textColorHint="@color/qm_icon_gray"
                        android:textColor="@color/qm_ink"
                        android:textSize="16sp"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:paddingStart="48dp"
                        android:paddingEnd="48dp"
                        android:contentDescription="@string/login_label_password" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/qm_ic_lock"
                        android:contentDescription="@string/login_icon_lock"
                        android:tint="@color/qm_icon_gray"
                        tools:ignore="UseAppTint" />

                    <!-- Show / hide password — 44dp touch target -->
                    <ImageButton
                        android:id="@+id/login_password_toggle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/qm_ic_eye"
                        android:tint="@color/qm_icon_gray"
                        android:contentDescription="@string/login_show_password"
                        android:visibility="invisible"
                        tools:ignore="UseAppTint" />
                </FrameLayout>

                <TextView
                    android:id="@+id/login_password_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/qm_error"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Enter your password"
                    tools:visibility="visible" />

                <!-- Forgot password — right aligned, 40dp touch target -->
                <TextView
                    android:id="@+id/login_forgot"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="@string/login_forgot_password"
                    android:textColor="@color/qm_wine"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground" />

                <!-- Screen-level error (credentials / network) -->
                <TextView
                    android:id="@+id/login_form_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:padding="12dp"
                    android:background="@drawable/qm_error_surface"
                    android:textColor="@color/qm_error"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="These credentials do not match our records."
                    tools:visibility="visible" />

                    <!-- ═══ Primary Sign In button ═══ -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/qm_login_field_height"
                        android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/login_submit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/qm_button_wine"
                        android:textColor="@color/qm_cream_on_wine"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        android:text="@string/login_sign_in"
                        android:paddingEnd="14dp"
                        android:stateListAnimator="@null" />

                    <ProgressBar
                        android:id="@+id/login_progress"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:indeterminateTint="@color/qm_cream_on_wine"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/login_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:text="→"
                        android:textColor="@color/qm_cream_on_wine"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- ═══ DEVELOPMENT diagnostics panel (v1.4.4, TEMPORARY)
                     Renders ONLY after a failed sign-in, ONLY when
                     BuildConfig.DEBUG is true (removed entirely from
                     release view at runtime). Approved design untouched —
                     this sits below the Sign In button, collapsed by
                     default, scrolls with the form. NO secrets: statuses,
                     durations, exception class names, yes/no flags only. ═══ -->
                <LinearLayout
                    android:id="@+id/login_diag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/qm_field"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <TextView
                        android:id="@+id/login_diag_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="@string/login_diag_title"
                        android:textColor="@color/qm_muted"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/login_diag_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/qm_ink"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.3"
                        android:visibility="gone"
                        tools:text="Origin: workpulse-gbpedt.drytis.dev"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/login_diag_probe"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="@string/login_diag_test_connection"
                        android:textColor="@color/qm_wine"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Bottom color composition — compact posters, FULLY visible
                 inside the safe area (no negative margins, no clipping) ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:baselineAligned="false"
                android:importantForAccessibility="no">

                <!-- GREEN card — wider, lower-left. Fixed height. -->
                <LinearLayout
                    android:id="@+id/login_card_green"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/qm_login_green_height"
                    android:layout_weight="1.3"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/qm_block_forest"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_green_line1"
                        android:textColor="@color/qm_lime"
                        android:textSize="@dimen/qm_login_bottom_card_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_green_line2"
                        android:textColor="@color/qm_lime"
                        android:textSize="@dimen/qm_login_bottom_card_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_green_line3"
                        android:textColor="@color/qm_lime"
                        android:textSize="@dimen/qm_login_bottom_card_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.08" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <!-- BLUE card — smaller, lower-right. Fixed height. -->
                <LinearLayout
                    android:id="@+id/login_card_blue"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/qm_login_blue_height"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/qm_block_cobalt"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_blue_line1"
                        android:textColor="@color/qm_cobalt_text"
                        android:textSize="@dimen/qm_login_bottom_card_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_blue_line2"
                        android:textColor="@color/qm_cobalt_text"
                        android:textSize="@dimen/qm_login_bottom_card_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_blue_line3"
                        android:textColor="@color/qm_lime"
                        android:textSize="@dimen/qm_login_bottom_card_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_blue_line4"
                        android:textColor="@color/qm_lime"
                        android:textSize="@dimen/qm_login_bottom_card_text"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.08" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
