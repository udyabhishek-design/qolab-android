<?xml version="1.0" encoding="utf-8"?>
<!--
  Qolab Mobile — Login (v1.4.1 compact layout)
  Same visual language, tightened for one-viewport entry screens.

  Height budget @393dp width (portrait, keyboard closed), everything measured:
    top pad 12 + brand 27 + 16 + headline 2×37 + 6 + sub 20 + 12
    + yellow 96 + 16 + label 18 + 6 + email 54 + 6 + gap 12 + label 18 + 6
    + password 54 + 2 + forgot 32 + 8 + error 0 + CTA 54 + bottom pad 12
  ≈ 688dp → fits 780dp-class viewports (Motorola G32) with margin, and the
  decorative peeks fill the leftover space below (or clip on short screens —
  they never push the form).

  ScrollView remains only as an a11y/font-scale/keyboard safety net.
  Bottom peeks are drawn by a fixed footer inside a root FrameLayout; they
  sit UNDER the scroll content, so they can never push authentication.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qm_canvas"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".LoginActivity">

    <!-- ── Decorative identity peeks (fixed, bottom corners, never scroll) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:importantForAccessibility="no"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Forest-green peek — enters from the LEFT edge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="-26dp"
                android:layout_marginBottom="-24dp"
                android:orientation="vertical"
                android:background="@drawable/qm_block_forest"
                android:paddingStart="30dp"
                android:paddingEnd="26dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_block_green_line3"
                    android:textColor="@color/qm_lime"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_block_green_line2"
                    android:textColor="@color/qm_lime"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.0" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Cobalt peek — enters from the RIGHT edge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="-22dp"
                android:layout_marginBottom="-20dp"
                android:orientation="vertical"
                android:background="@drawable/qm_block_cobalt"
                android:paddingStart="26dp"
                android:paddingEnd="30dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_block_blue_line3"
                    android:textColor="@color/qm_lime"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_block_blue_line4"
                    android:textColor="@color/qm_cobalt_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.0" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Primary content ── -->
    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:descendantFocusability="beforeDescendants"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="@dimen/qm_login_top_pad"
            android:paddingBottom="16dp">

            <!-- Vertical distribution: spacers (0dp, weight) absorb leftover
                 height so the form sits slightly above center on tall
                 screens and yields entirely when the keyboard opens
                 (adjustResize shrinks the viewport → weights collapse to 0
                 before the fixed content ever scrolls). -->

            <!-- ═══ Brand — wordmark + red dot ═══ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_wordmark"
                    android:textColor="@color/qm_ink"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:fontFamily="sans-serif-black"
                    android:contentDescription="@string/login_wordmark" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/qm_red_dot"
                    android:contentDescription="@string/login_wordmark" />
            </LinearLayout>

            <!-- ═══ Headline (full width) ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/login_headline_line1"
                android:textColor="@color/qm_ink"
                android:textSize="@dimen/qm_login_headline"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/login_headline_line2"
                android:textColor="@color/qm_wine"
                android:textSize="@dimen/qm_login_headline"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.04" />

            <!-- Subcopy + compact yellow accent block side by side (upper
                 portion, right side). The block is a design accent, NOT
                 interactive, and never determines the screen height budget
                 because the subcopy beside it is shorter. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="top"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:text="@string/login_subcopy"
                    android:textColor="@color/qm_muted"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.25"
                    android:maxLines="3" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/qm_block_yellow"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:importantForAccessibility="no">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_yellow_line1"
                        android:textColor="@color/qm_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_yellow_line2"
                        android:textColor="@color/qm_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_yellow_line3"
                        android:textColor="@color/qm_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_block_yellow_line4"
                        android:textColor="@color/qm_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingMultiplier="1.12" />

                    <!-- Minimal accent line -->
                    <View
                        android:layout_width="24dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/qm_ink" />
                </LinearLayout>
            </LinearLayout>

            <!-- Flexible spacer above the form -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="18"
                android:minHeight="10dp" />

            <!-- ═══ Login form ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Work email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_label_email"
                    android:textColor="@color/qm_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">

                    <EditText
                        android:id="@+id/login_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/qm_login_field_height"
                        android:background="@drawable/qm_field"
                        android:hint="@string/login_hint_email"
                        android:textColorHint="@color/qm_icon_gray"
                        android:textColor="@color/qm_ink"
                        android:textSize="16sp"
                        android:inputType="textEmailAddress"
                        android:autofillHints="email"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:paddingStart="48dp"
                        android:paddingEnd="14dp"
                        android:contentDescription="@string/login_label_email" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/qm_ic_mail"
                        android:contentDescription="@string/login_icon_mail"
                        android:tint="@color/qm_icon_gray"
                        tools:ignore="UseAppTint" />
                </FrameLayout>

                <TextView
                    android:id="@+id/login_email_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/qm_error"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Enter a valid email address"
                    tools:visibility="visible" />

                <!-- Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/login_label_password"
                    android:textColor="@color/qm_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">

                    <EditText
                        android:id="@+id/login_password"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/qm_login_field_height"
                        android:background="@drawable/qm_field"
                        android:hint="@string/login_hint_password"
                        android:textColorHint="@color/qm_icon_gray"
                        android:textColor="@color/qm_ink"
                        android:textSize="16sp"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:paddingStart="48dp"
                        android:paddingEnd="48dp"
                        android:contentDescription="@string/login_label_password" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/qm_ic_lock"
                        android:contentDescription="@string/login_icon_lock"
                        android:tint="@color/qm_icon_gray"
                        tools:ignore="UseAppTint" />

                    <!-- Show / hide password — 44dp touch target -->
                    <ImageButton
                        android:id="@+id/login_password_toggle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/qm_ic_eye"
                        android:tint="@color/qm_icon_gray"
                        android:contentDescription="@string/login_show_password"
                        android:visibility="invisible"
                        tools:ignore="UseAppTint" />
                </FrameLayout>

                <TextView
                    android:id="@+id/login_password_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/qm_error"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Enter your password"
                    tools:visibility="visible" />

                <!-- Forgot password — right aligned, tight but 40dp target -->
                <TextView
                    android:id="@+id/login_forgot"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="@string/login_forgot_password"
                    android:textColor="@color/qm_wine"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground" />

                <!-- Screen-level error (credentials / network) -->
                <TextView
                    android:id="@+id/login_form_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:padding="12dp"
                    android:background="@drawable/qm_error_surface"
                    android:textColor="@color/qm_error"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="These credentials do not match our records."
                    tools:visibility="visible" />

                <!-- ═══ Primary Sign In button ═══ -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qm_login_field_height"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/login_submit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/qm_button_wine"
                        android:textColor="@color/qm_cream_on_wine"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        android:text="@string/login_sign_in"
                        android:paddingEnd="14dp"
                        android:stateListAnimator="@null" />

                    <!-- Inline spinner shown inside the button while signing in -->
                    <ProgressBar
                        android:id="@+id/login_progress"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:indeterminateTint="@color/qm_cream_on_wine"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Arrow "→" -->
                    <TextView
                        android:id="@+id/login_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:text="→"
                        android:textColor="@color/qm_cream_on_wine"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Flexible spacer below the form (weight 10; with fillViewport
                 the leftover space splits 18:10 above/below the form so the
                 composition stays balanced, while the bottom decorative
                 peeks — layered beneath this scroll — fill the visual base) -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="10"
                android:minHeight="8dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
