<?xml version="1.0" encoding="utf-8"?>
<!-- ═══ Qolab Mobile — Meetings list (v1.5.49) ═══
     Approved Qolab design system (warm light canvas, wordmark header,
     sectioned list). Upcoming first, then Past. Rows reuse the proven
     room meeting-row visual. Skeleton / error+Retry / empty states. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/qm_canvas">

    <!-- Header: wordmark + heading (matches Chat list pattern) -->
    <LinearLayout
        android:id="@+id/meetings_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/qm_room_page_pad"
        android:paddingEnd="@dimen/qm_room_page_pad"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meetings_wordmark"
                    android:textColor="@color/qm_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/qm_bg_pin_circle"
                    android:backgroundTint="@color/qm_red_dot"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/meetings_title"
                android:textColor="@color/qm_ink"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/meetings_subtitle"
                android:textColor="@color/qm_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/meetings_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/qm_ic_back"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/room_cd_back" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/meetings_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/meetings_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/qm_room_page_pad"
                android:paddingEnd="@dimen/qm_room_page_pad"
                android:paddingTop="6dp"
                android:paddingBottom="24dp" />
        </ScrollView>

        <!-- Skeleton -->
        <LinearLayout
            android:id="@+id/meetings_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/qm_room_page_pad"
            android:paddingEnd="@dimen/qm_room_page_pad"
            android:paddingTop="6dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:background="@drawable/qm_bg_skeleton" />
        </LinearLayout>

        <!-- Error + Retry -->
        <LinearLayout
            android:id="@+id/meetings_error_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/room_error"
                android:textColor="@color/qm_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meetings_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:text="@string/room_retry"
                android:textColor="@color/qm_wine"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty -->
        <TextView
            android:id="@+id/meetings_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:gravity="center"
            android:text="@string/meetings_empty"
            android:textColor="@color/qm_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
