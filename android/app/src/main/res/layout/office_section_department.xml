<?xml version="1.0" encoding="utf-8"?>
<!-- Office — Department Rooms: the user's real department room (orange card)
     or a polished native empty state. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qm_home_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/office_department_rooms"
            android:textColor="@color/qm_ink"
            android:textSize="@dimen/qm_home_section_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/office_dept_see_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/office_see_all"
            android:textColor="@color/qm_wine"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/office_dept_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qm_home_dept_height"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/qm_bg_card_orange"
        android:padding="@dimen/qm_home_card_pad"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/office_dept_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/qm_orange_text"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/office_dept_online"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/qm_orange_text"
                    android:alpha="0.8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/office_dept_enter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:background="@drawable/qm_bg_btn_enter_dark"
                android:text="@string/home_room_enter_with_arrow"
                android:textColor="@color/qm_enter_label"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/office_dept_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/qm_orange_text"
            android:alpha="0.85"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/office_dept_avatars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/office_dept_overflow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:textColor="@color/qm_orange_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/office_dept_empty"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qm_home_dept_height"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/qm_bg_card_white"
        android:padding="@dimen/qm_home_card_pad"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_dept_empty_title"
            android:textColor="@color/qm_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_dept_empty_support"
            android:textColor="@color/qm_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/office_dept_skeleton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qm_home_dept_height"
        android:layout_marginTop="8dp"
        android:background="@drawable/qm_bg_skeleton" />

    <TextView
        android:id="@+id/office_dept_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="6dp"
        android:text="@string/home_retry"
        android:textColor="@color/qm_wine"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
