<?xml version="1.0" encoding="utf-8"?>
<!-- ═══ Qolab Mobile — Chat: one conversation ═══
     Header (back, title, member count) → messages (RecyclerView-like
     ScrollView) → composer (input + send). Own messages right-aligned
     wine bubbles; others left-aligned white cards. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/qm_canvas">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/qm_room_page_pad"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/chat_screen_back"
            android:layout_width="@dimen/qm_room_back_target"
            android:layout_height="@dimen/qm_room_back_target"
            android:src="@drawable/qm_ic_back"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/room_cd_back" />

        <TextView
            android:id="@+id/chat_screen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:textColor="@color/qm_ink"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/chat_screen_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/qm_muted"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Messages -->
        <ScrollView
            android:id="@+id/chat_messages_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/chat_messages_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/qm_room_page_pad"
                android:paddingEnd="@dimen/qm_room_page_pad"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </ScrollView>

        <!-- Skeleton -->
        <LinearLayout
            android:id="@+id/chat_messages_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/qm_room_page_pad"
            android:paddingEnd="@dimen/qm_room_page_pad"
            android:paddingTop="6dp">

            <View
                android:layout_width="200dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="start"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="240dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="end"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="180dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="start"
                android:background="@drawable/qm_bg_skeleton" />
            <View
                android:layout_width="220dp"
                android:layout_height="44dp"
                android:background="@drawable/qm_bg_skeleton"
                android:layout_gravity="end" />
        </LinearLayout>

        <!-- Error + retry -->
        <LinearLayout
            android:id="@+id/chat_messages_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/room_error"
                android:textColor="@color/qm_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_messages_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:text="@string/room_retry"
                android:textColor="@color/qm_wine"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty history -->
        <TextView
            android:id="@+id/chat_messages_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/chat_no_messages"
            android:textColor="@color/qm_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/qm_room_page_pad"
        android:paddingEnd="@dimen/qm_room_page_pad"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/chat_composer_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="46dp"
            android:background="@drawable/qm_bg_room_card"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:hint="@string/chat_composer_hint"
            android:textColorHint="@color/qm_muted"
            android:textColor="@color/qm_ink"
            android:textSize="14sp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:imeOptions="actionSend" />

        <TextView
            android:id="@+id/chat_composer_send"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/qm_button_wine"
            android:text="@string/chat_send"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
