<?xml version="1.0" encoding="utf-8"?>
<!-- ═══ Qolab Mobile — Office (native, V1) ═══
     Section order per approved reference: header → Office title →
     Social Rooms grid → Department Rooms → People Around → Quick Access.
     Bottom nav is a sibling below (fixed). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qm_canvas">

    <ScrollView
        android:id="@+id/office_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/qm_home_page_pad"
            android:paddingEnd="@dimen/qm_home_page_pad"
            android:paddingTop="12dp"
            android:paddingBottom="@dimen/qm_home_content_bottom_pad">

            <include layout="@layout/office_section_header" />
            <include layout="@layout/office_section_title" />
            <include layout="@layout/office_section_rooms" />
            <include layout="@layout/office_section_department" />
            <include layout="@layout/office_section_people" />
            <include layout="@layout/office_section_quick" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_office_bottom_nav" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
